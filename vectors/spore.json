{
 "vector": "1.0",
 "operation": "verify_spore",
 "spec": "Evidence Format 1.0 section 12",
 "description": "Spore documents: the stop_key_holders list and the closed schema.",
 "cases": [
  {
   "id": "minimal",
   "description": "the smallest valid Spore: one human stop key holder",
   "input": {
    "spore_json": "{\n \"spore\": \"1.0\",\n \"ilorium\": \"1.0\",\n \"organism\": \"organism-zero\",\n \"domain\": \"example.org\",\n \"stop_key_holders\": [\n  {\n   \"kind\": \"human\",\n   \"id\": \"holder-1\",\n   \"name\": \"Holder 1\",\n   \"contact\": \"holder1@example.org\",\n   \"credential\": \"https://example.org/credentials/1\"\n  }\n ]\n}"
   },
   "expect": {
    "verdict": "PASS",
    "checks": {
     "spore.schema": "PASS",
     "spore.holders": "PASS"
    }
   }
  },
  {
   "id": "full",
   "description": "every optional field, two holders (a human and an institution)",
   "input": {
    "spore_json": "{\n \"spore\": \"1.0\",\n \"ilorium\": \"1.0\",\n \"organism\": \"organism-zero\",\n \"domain\": \"example.org\",\n \"stop_key_holders\": [\n  {\n   \"kind\": \"human\",\n   \"id\": \"holder-1\",\n   \"name\": \"Holder 1\",\n   \"contact\": \"holder1@example.org\",\n   \"credential\": \"https://example.org/credentials/1\"\n  },\n  {\n   \"kind\": \"institution\",\n   \"id\": \"holder-2\",\n   \"name\": \"Holder 2\",\n   \"contact\": \"holder2@example.org\",\n   \"credential\": \"https://example.org/credentials/2\"\n  }\n ],\n \"genome\": \"1.0\",\n \"probe\": \"1.0\",\n \"membrane\": [\n  \"github.com/example\"\n ],\n \"responsible\": \"Example Founder\",\n \"threshold\": {\n  \"platform\": \"github\",\n  \"group\": \"example/core\",\n  \"sentinel\": \"example/sentinel\",\n  \"commands\": [\n   \"/stop\"\n  ]\n },\n \"agents\": {\n  \"oz-architect\": [\n   \"oz-architect[bot]\"\n  ]\n },\n \"pulse_key\": \"ed25519:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=\",\n \"pulse\": {\n  \"every_beats\": 100,\n  \"max_interval_s\": 3600,\n  \"challenge_deadline_s\": 300\n },\n \"checkpoints\": {\n  \"url\": \"https://example.org/checkpoints\",\n  \"every_beats\": 100,\n  \"max_interval_s\": 3600\n },\n \"witnesses\": [\n  \"witness-a\"\n ],\n \"humans\": [\n  {\n   \"id\": \"founder\",\n   \"role\": \"founder\",\n   \"accounts\": [\n    \"github:founder\"\n   ]\n  }\n ],\n \"announce\": true\n}"
   },
   "expect": {
    "verdict": "PASS",
    "checks": {}
   }
  },
  {
   "id": "wardens",
   "description": "three holders: anyone can stop, so any number is valid",
   "input": {
    "spore_json": "{\n \"spore\": \"1.0\",\n \"ilorium\": \"1.0\",\n \"organism\": \"organism-zero\",\n \"domain\": \"example.org\",\n \"stop_key_holders\": [\n  {\n   \"kind\": \"institution\",\n   \"id\": \"holder-1\",\n   \"name\": \"Holder 1\",\n   \"contact\": \"holder1@example.org\",\n   \"credential\": \"https://example.org/credentials/1\"\n  },\n  {\n   \"kind\": \"institution\",\n   \"id\": \"holder-2\",\n   \"name\": \"Holder 2\",\n   \"contact\": \"holder2@example.org\",\n   \"credential\": \"https://example.org/credentials/2\"\n  },\n  {\n   \"kind\": \"human\",\n   \"id\": \"holder-3\",\n   \"name\": \"Holder 3\",\n   \"contact\": \"holder3@example.org\",\n   \"credential\": \"https://example.org/credentials/3\"\n  }\n ]\n}"
   },
   "expect": {
    "verdict": "PASS",
    "checks": {}
   }
  },
