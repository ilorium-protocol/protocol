{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilorium.com/schemas/1.0/spore.schema.json",
  "title": "Ilorium Spore (draft)",
  "description": "The Spore served at /.well-known/ilorium.json. Evidence Format 1.0 (draft), section 12; its meaning is in the Probe specification (section 15) and the Discovery and Growth specification. The fields marked as draft there may change before a Spore specification exists. Licensed under Apache-2.0.",
  "type": "object",
  "required": [
    "spore",
    "ilorium",
    "organism",
    "domain",
    "stop_key_holders"
  ],
  "additionalProperties": false,
  "properties": {
    "spore": {
      "const": "1.0"
    },
    "ilorium": {
      "$ref": "common.schema.json#/$defs/release"
    },
    "organism": {
      "$ref": "common.schema.json#/$defs/label"
    },
    "domain": {
      "$ref": "common.schema.json#/$defs/domain"
    },
    "genome": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "probe": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "membrane": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "common.schema.json#/$defs/name"
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "commands"
      ],
      "properties": {
        "platform": {
          "$ref": "common.schema.json#/$defs/label"
        },
        "group": {
          "$ref": "common.schema.json#/$defs/name"
        },
        "sentinel": {
          "$ref": "common.schema.json#/$defs/name"
        },
        "commands": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "common.schema.json#/$defs/name"
          }
        }
      }
    },
    "agents": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/label"
      },
      "additionalProperties": {
        "type": "array",
        "maxItems": 256,
        "items": {
          "$ref": "common.schema.json#/$defs/name"
        }
      }
    },
    "work_units": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "source",
          "success"
        ],
        "properties": {
          "type": {
            "$ref": "common.schema.json#/$defs/label"
          },
          "source": {
            "$ref": "common.schema.json#/$defs/label"
          },
          "success": {
            "$ref": "common.schema.json#/$defs/name"
          }
        }
      }
    },
    "pulse_key": {
      "$ref": "common.schema.json#/$defs/ed25519_key"
    },
    "pulse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_beats",
        "max_interval_s",
        "challenge_deadline_s"
      ],
      "properties": {
        "every_beats": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_interval_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "challenge_deadline_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "checkpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "every_beats",
        "max_interval_s"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "maxLength": 2048
        },
        "every_beats": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_interval_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "witnesses": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "common.schema.json#/$defs/name"
      }
    },
    "humans": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "accounts"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/name"
          },
          "role": {
            "$ref": "common.schema.json#/$defs/label"
          },
          "accounts": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "common.schema.json#/$defs/name"
            }
          }
        }
      }
    },
    "responsible": {
      "$ref": "common.schema.json#/$defs/name"
    },
    "stop_key_holders": {
      "description": "Who holds the organism's stop key. Any one holder can stop the organism. Always humans or human-governed institutions, never an organism. A lineage with no human founders lists its Wardens here (at least two, independent of the organism, its lineage and each other: a rule of the Genome, checked against the succession record, not by this schema).",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "common.schema.json#/$defs/stop_key_holder"
      }
    },
    "kin": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation",
          "domain",
          "succession"
        ],
        "properties": {
          "relation": {
            "enum": [
              "parent",
              "descendant",
              "inherited_from",
              "coalesced_from",
              "coalesced_into"
            ]
          },
          "domain": {
            "$ref": "common.schema.json#/$defs/domain"
          },
          "succession": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "partners": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "since"
        ],
        "properties": {
          "domain": {
            "$ref": "common.schema.json#/$defs/domain"
          },
          "since": {
            "$ref": "common.schema.json#/$defs/time"
          }
        }
      }
    },
    "announce": {
      "type": "boolean"
    },
    "signatures": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 8192
      }
    }
  }
}
