{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilorium.com/schemas/1.0/bundle.schema.json",
  "title": "Ilorium Evidence Bundle manifest (draft)",
  "description": "bundle.json, the manifest of an Evidence Bundle. Evidence Format 1.0 (draft), section 13. A list of checksums over a Strata export and the Spore; it carries no keys and is not signed. Licensed under Apache-2.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle",
    "ilorium",
    "organism",
    "domain",
    "origin",
    "created_at",
    "period",
    "files"
  ],
  "properties": {
    "bundle": {
      "const": "1.0"
    },
    "ilorium": {
      "$ref": "common.schema.json#/$defs/release"
    },
    "organism": {
      "$ref": "common.schema.json#/$defs/label"
    },
    "domain": {
      "$ref": "common.schema.json#/$defs/domain"
    },
    "origin": {
      "$ref": "common.schema.json#/$defs/origin"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "to": {
          "$ref": "common.schema.json#/$defs/time"
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records.jsonl",
        "spore.json"
      ],
      "properties": {
        "records.jsonl": {
          "$ref": "#/$defs/jsonl_ref"
        },
        "checkpoints.jsonl": {
          "$ref": "#/$defs/jsonl_ref"
        },
        "pulses.jsonl": {
          "$ref": "#/$defs/jsonl_ref"
        },
        "spore.json": {
          "$ref": "#/$defs/file_ref"
        }
      }
    }
  },
  "$defs": {
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes"
      ],
      "properties": {
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "bytes": {
          "$ref": "common.schema.json#/$defs/uint"
        }
      }
    },
    "jsonl_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes",
        "entries"
      ],
      "properties": {
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "bytes": {
          "$ref": "common.schema.json#/$defs/uint"
        },
        "entries": {
          "$ref": "common.schema.json#/$defs/uint"
        }
      }
    }
  }
}
