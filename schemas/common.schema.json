{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilorium.com/schemas/1.0/common.schema.json",
  "title": "Ilorium common definitions",
  "description": "Shared definitions for the Ilorium Evidence Format 1.0 (draft). Licensed under Apache-2.0.",
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ed25519_key": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9+/]{43}=$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "uint": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "release": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "label": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:-]{0,63}$"
    },
    "domain": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
    },
    "origin": {
      "type": "string",
      "pattern": "^[^\\s+\\u0000-\\u001f\\u007f]{1,255}$"
    },
    "vkey": {
      "type": "string",
      "pattern": "^[^\\s+\\u0000-\\u001f\\u007f]+\\+[0-9a-f]{8}\\+[A-Za-z0-9+/]+={0,2}$"
    },
    "scalar": {
      "type": [
        "string",
        "integer",
        "boolean"
      ]
    },
    "stop_key_holder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "name",
        "contact",
        "credential"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "institution"
          ]
        },
        "id": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "contact": {
          "$ref": "#/$defs/name"
        },
        "credential": {
          "$ref": "#/$defs/name"
        }
      }
    }
  }
}
